<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.NetScriptEditorWindow"
        x:DataType="vm:NetScriptEditorViewModel"
        Title="Net Script Editor"
        PanelTitle="Net Script Editor"
        Width="700" Height="540" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                 Text="Pre-write net preambles and announcements. Template variables: {{callsign}}, {{date}}, {{time}}, {{net_name}}" />

      <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" ClipToBounds="True">
        <Grid ColumnDefinitions="220,*">
          <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
              <ListBox Grid.Row="0" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetScriptRowViewModel">
                    <StackPanel Spacing="2" Margin="6,4">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding Preview}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="1" Command="{Binding NewCommand}" Content="＋ New script"
                      HorizontalAlignment="Stretch" Padding="0,8" HorizontalContentAlignment="Center" FontSize="11" />
            </Grid>
          </Border>
          <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="14,10,14,6">
              <StackPanel Spacing="2">
                <TextBlock Text="Script name" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox Text="{Binding EditName}" Watermark="e.g. ARES Weekly Net" FontSize="12" />
              </StackPanel>
            </Border>
            <TextBox Grid.Row="1" Text="{Binding EditBody}" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas, Cascadia Code, Menlo, Courier New" FontSize="11" Padding="14,8"
                     BorderThickness="0,1,0,0"
                     Watermark="Write your net preamble here…&#10;Template variables: {{callsign}}, {{date}}, {{time}}, {{net_name}}" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding CopyCommand}" Content="Copy to clipboard" Padding="10,6" FontSize="11"
                ToolTip.Tip="Resolves {{callsign}}, {{date}}, {{time}} and copies to clipboard"
                IsEnabled="{Binding SelectedScript, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="Save" Padding="10,6" FontSize="11" />
        <Button Grid.Column="3" Command="{Binding DeleteCommand}" Content="Delete" Padding="10,6" FontSize="11"
                IsEnabled="{Binding SelectedScript, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
