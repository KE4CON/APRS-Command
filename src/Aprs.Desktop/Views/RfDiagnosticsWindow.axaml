<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.RfDiagnosticsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — RF Diagnostics"
        PanelTitle="RF Diagnostics"
        Width="900" Height="640" MinWidth="600" MinHeight="440">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Low-level TNC and modem diagnostics — frame counts, decode errors, station rates, and path warnings. Use when something on the radio side isn't working right."
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <views:RfDiagnosticsView DataContext="{Binding RfDiagnostics}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
