<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.AboutWindow"
        Title="About APRS Command"
        PanelTitle="About APRS Command"
        Width="460" SizeToContent="Height"
        MinWidth="460" MaxWidth="460" MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="26,22" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <StackPanel Spacing="0">
      <TextBlock Text="APRS Command" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />

      <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,18,0,18" />

      <TextBlock Text="A cross-platform APRS client for amateur radio operators."
                 FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
        <TextBlock Grid.Row="0" Text="Operator:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CallsignText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Runtime:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="2" Text="Platform:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PlatformText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="3" Text="Source:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="github.com/KE4CON/APRS-Command" FontSize="11"
                   Foreground="{DynamicResource AccentBlueMidBrush}" Cursor="Hand" PointerPressed="RepoLink_PointerPressed" />
        <TextBlock Grid.Row="4" Text="License:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="GPL v3" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
      </Grid>

      <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,18,0,14" />

      <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                 Text="Built on Avalonia UI, Mapsui, and BruTile." />
      <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                 Text="Inspired by the vision of Bob Bruninga WB4APR (SK), father of APRS, who designed it as a situational awareness tool — and by UI-View32, written by Roger Barker G4IDE (SK). Released under GPL v3 so it can live on." />

      <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,16,0,12" />

      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="CheckUpdateButton" Content="Check for updates" Padding="12,6" />
          <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="Not checked yet." />
        </StackPanel>
        <TextBlock x:Name="UpdateDetailText" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="False" />
      </StackPanel>

      <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,16,0,12" />

      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="UpdateDeviceDbButton" Content="Update device database" Padding="12,6" />
          <TextBlock x:Name="DeviceDbStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                   Text="Identifies each station's radio or software from its APRS ID. Refreshes automatically about once a week; the built-in copy always works offline." />
      </StackPanel>
    </StackPanel>
  </Border>
</ctrls:FloatingPanelWindow>
