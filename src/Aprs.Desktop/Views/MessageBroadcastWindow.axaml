<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.MessageBroadcastWindow"
        x:DataType="vm:MessageBroadcastViewModel"
        Title="Message Broadcast"
        PanelTitle="Message Broadcast"
        Width="580" Height="500" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <!-- Compose -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Send one message to multiple stations. Separate callsigns with commas." />
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Recipients (comma-separated)" FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Command="{Binding AddFromRosterCommand}"
                      Content="＋ From net roster" Padding="8,3" FontSize="11" />
            </Grid>
            <TextBox Text="{Binding RecipientList}" Watermark="e.g. W4ABC, KD4XYZ, N4DEF" AcceptsReturn="False" />
            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
              <Run Text="{Binding RecipientCount}" /><Run Text=" recipient(s)" />
            </TextBlock>
          </StackPanel>
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Message" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                <Run Text="{Binding CharCount}" /><Run Text="/67 chars" />
              </TextBlock>
            </Grid>
            <TextBox Text="{Binding MessageBody}" Watermark="Message text (max 67 characters)" MaxLength="67" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Results -->
      <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Results" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BroadcastResultViewModel">
                <Grid ColumnDefinitions="30,120,*" Margin="4,2">
                  <TextBlock Text="{Binding Icon}" FontSize="14" FontWeight="Bold" Foreground="{Binding Color}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Callsign}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Footer -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding SendCommand}" Content="Send to all" Padding="14,6" IsEnabled="{Binding IsNotSending}" />
        <Button Grid.Column="2" Command="{Binding ClearCommand}" Content="Clear results" Padding="10,6" FontSize="11" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
