<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.RawPacketsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — Raw Packet Monitor"
        PanelTitle="Raw Packet Monitor"
        Width="900" Height="600" MinWidth="600" MinHeight="440">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Every packet received on all active ports, in arrival order. If packets appear here, the port is receiving. Save Log writes the log to a file you can load in the Replay window."
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
        <Button Content="Save Log" Padding="14,6"
                ToolTip.Tip="Save all received packets to a file that can be loaded in the Replay window"
                Click="SaveLog_Click" />
        <TextBlock Grid.Column="1"
                   Name="SaveStatusText"
                   Text="Tip: save the log here, then open Replay to play it back without transmitting."
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="12,0" />
      </Grid>
      <views:PacketMonitorView DataContext="{Binding RawPacketLog}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
