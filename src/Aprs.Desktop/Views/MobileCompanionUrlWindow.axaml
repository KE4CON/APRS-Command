<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.MobileCompanionUrlWindow"
        Title="Mobile Companion Web View"
        PanelTitle="Mobile Companion"
        Width="420" Height="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="18" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <StackPanel Spacing="14">
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="The companion web server is running. Open this URL on any device on the same network as this computer — your phone, tablet, or another laptop." />
      <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel Spacing="6">
          <TextBlock Text="Open this URL on your phone:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock x:Name="UrlText" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                 Text="Your phone must be on the same WiFi network as this computer. The server runs only while APRS Command is open. Open this menu item again to see the URL if you close this window." />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="CopyButton" Content="Copy URL" Padding="14,7" Click="OnCopyClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</ctrls:FloatingPanelWindow>
