<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.MessagesWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — Messages"
        PanelTitle="Messages"
        Width="900" Height="680" MinWidth="700" MinHeight="500">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Direct messages, bulletins, announcements and queries. Inbox shows messages addressed to your callsign. Use the Compose tab to send a direct message — your callsign is filled in automatically from Station Setup."
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <views:MessageCenterView DataContext="{Binding MessageCenter}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
