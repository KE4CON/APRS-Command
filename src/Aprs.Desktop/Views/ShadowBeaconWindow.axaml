<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.ShadowBeaconWindow"
        x:DataType="vm:ShadowBeaconViewModel"
        Title="Shadow Beacon"
        PanelTitle="Shadow Beacon"
        Width="620" Height="500" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <!-- Input form -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                     Text="Transmit a position on behalf of a non-APRS station. The station will appear on all APRS maps." />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Callsign to track *" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding TrackedCallsign}" Watermark="e.g. W4ABC-9" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Latitude *" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding LatitudeText}" Watermark="e.g. 33.7490" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Longitude *" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding LongitudeText}" Watermark="e.g. -84.3880" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="80,80,*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Symbol table" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding SymbolTable}" Watermark="/" MaxLength="1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Symbol code" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding SymbolCode}" Watermark=">" MaxLength="1" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Comment" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding Comment}" Watermark="Optional description" />
            </StackPanel>
            <Button Grid.Column="3" Command="{Binding TransmitCommand}" Content="Transmit" Padding="14,6"
                    IsEnabled="{Binding IsNotTransmitting}" VerticalAlignment="Bottom" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Active shadow stations list -->
      <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Active shadow stations" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding ActiveStations}"
                   SelectedItem="{Binding SelectedStation}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ShadowStationRowViewModel">
                <Grid ColumnDefinitions="120,140,80,*" Margin="4,3">
                  <TextBlock Text="{Binding Callsign}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBlueMidBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding LastTx}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Comment}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Footer -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Command="{Binding RemoveCommand}" Content="Remove selected" Padding="10,6" FontSize="11"
                IsEnabled="{Binding SelectedStation, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="2" Command="{Binding ClearAllCommand}" Content="Clear all" Padding="10,6" FontSize="11" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
