<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.StationListWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — Station List"
        PanelTitle="Station List"
        Width="760" Height="620" MinWidth="600" MinHeight="440">

  <!-- Chrome (grip title bar, accent hairline, rounded surface) is supplied by the shared theme.
       This is just the window's content: an elevated card holding the station list. -->
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Every station heard on your active connections, newest first. Click a callsign to center the map on it."
                 Foreground="{DynamicResource TextSubtleBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <views:StationListView DataContext="{Binding StationList}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
