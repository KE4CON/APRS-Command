<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.DirewolfProfileWindow"
        x:DataType="vm:DirewolfProfileViewModel"
        Title="Direwolf Profile"
        PanelTitle="Direwolf Profile"
        Width="820" Height="640" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <views:DirewolfProfileView />
</ctrls:FloatingPanelWindow>
