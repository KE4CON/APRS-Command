<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.ScheduledMessagesWindow"
        x:DataType="vm:ScheduledMessagesViewModel"
        Title="Scheduled Messages"
        PanelTitle="Scheduled Messages"
        Width="600" Height="480" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <!-- Compose -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Compose a message now and schedule it for future delivery. The app must be running at send time." />
          <Grid ColumnDefinitions="*,110,90" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Recipient" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding Recipient}" Watermark="e.g. W4ABC" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Send date" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding SendDate}" Watermark="MM/dd/yyyy" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Send time" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox Text="{Binding SendTime}" Watermark="HH:mm" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Message" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                <Run Text="{Binding CharCount}" /><Run Text="/67" />
              </TextBlock>
            </Grid>
            <TextBox Text="{Binding Body}" Watermark="Message text (max 67 characters)" MaxLength="67" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Scheduled messages list -->
      <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Scheduled messages" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Messages}"
                   SelectedItem="{Binding SelectedMessage}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ScheduledMessageRowViewModel">
                <Grid ColumnDefinitions="90,100,*,90" Margin="4,3">
                  <TextBlock Text="{Binding Recipient}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBlueMidBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding SendAtLocal}" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Body}" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="10"
                             Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Footer -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding ScheduleCommand}" Content="Schedule" Padding="14,6" />
        <Button Grid.Column="2" Command="{Binding CancelCommand}" Content="Cancel selected" Padding="10,6" FontSize="11"
                IsEnabled="{Binding SelectedMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
