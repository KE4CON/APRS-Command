<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.MessageReceiptsDashboardWindow"
        x:DataType="vm:MessageReceiptsDashboardViewModel"
        Title="Message Read Receipts Dashboard"
        PanelTitle="Message Receipts"
        Width="720" Height="560" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

      <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Overview of message delivery status across the session." />

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
        <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Total" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding AcknowledgedCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#15803d" />
            <TextBlock Text="Acknowledged" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding WaitingCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1d4ed8" />
            <TextBlock Text="Waiting" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6b7280" />
            <TextBlock Text="Pending" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding FailedCount}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#dc2626" />
            <TextBlock Text="Failed" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Text="Messages" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}" FontSize="11" Width="150" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReceiptRowViewModel">
                <Grid ColumnDefinitions="34,30,80,80,*,110" Margin="4,3">
                  <TextBlock Text="{Binding StatusIcon}" FontSize="13" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Sender}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueMidBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Recipient}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Text="{Binding Body}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="5" Text="{Binding StatusLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh" Padding="10,6" FontSize="11" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
