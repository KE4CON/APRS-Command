<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.SettingsWindow"
        Title="APRS Command Settings"
        PanelTitle="Settings"
        Width="900" Height="680" MinWidth="720" MinHeight="520">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <views:SettingsView />
  </Border>
</ctrls:FloatingPanelWindow>
