<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.ElevationProfileWindow"
        x:DataType="vm:ElevationProfileViewModel"
        Title="Elevation Profile"
        PanelTitle="Elevation Profile"
        Width="680" Height="520" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Padding="16" Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 6 18 -10 #33101828">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="From callsign" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox Text="{Binding FromCallsign}" Watermark="e.g. KE4CON" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" />
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="To callsign" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox Text="{Binding ToCallsign}" Watermark="e.g. W4ABC" />
          </StackPanel>
          <Button Grid.Column="3" Command="{Binding GenerateCommand}" Content="Generate Profile" Padding="14,6"
                  IsEnabled="{Binding IsNotLoading}" VerticalAlignment="Bottom" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="12" ClipToBounds="True">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4" />
            <TextBlock IsVisible="{Binding IsLoading}" Text="Fetching elevation data from Open Elevation API…"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBox Text="{Binding ProfileText}" IsReadOnly="True"
                     FontFamily="Consolas, Cascadia Code, Menlo, Courier New" FontSize="11"
                     Background="Transparent" BorderThickness="0" TextWrapping="NoWrap"
                     AcceptsReturn="True" IsVisible="{Binding IsNotLoading}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
    </Grid>
  </Border>
</ctrls:FloatingPanelWindow>
