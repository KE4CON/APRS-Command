<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.WeatherWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — Weather"
        PanelTitle="Weather"
        Width="800" Height="600" MinWidth="600" MinHeight="440">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="APRS weather station data received from the network. Shows current conditions reported by nearby weather stations."
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <views:WeatherView DataContext="{Binding Weather}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
