<ctrls:FloatingPanelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Aprs.Desktop.Views"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:ctrls="using:Aprs.Desktop.Controls"
        x:Class="Aprs.Desktop.Views.ReplayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command — Replay"
        PanelTitle="Replay"
        WindowStartupLocation="CenterScreen"
        Width="800" Height="580" MinWidth="600" MinHeight="440">
  <Border Margin="16" Padding="16"
          Background="{DynamicResource PanelAccentBgBrush}"
          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
          CornerRadius="12" BoxShadow="0 6 18 -10 #33101828">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Replay a saved packet log as if it were live traffic — no transmitting occurs. Open Raw Packet Monitor, let it collect packets, then Save Log; here click Load, pick the file, then Play. Pause and Stop control playback; Loop repeats it."
                 Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12" />
      <views:ReplayView DataContext="{Binding Replay}" />
    </DockPanel>
  </Border>
</ctrls:FloatingPanelWindow>
