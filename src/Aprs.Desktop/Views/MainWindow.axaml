<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aprs.Desktop.ViewModels"
        xmlns:views="using:Aprs.Desktop.Views"
        x:Class="Aprs.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APRS Command"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="620">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenNetControlCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding BeaconNowCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleDarkModeCommand}" />
    <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding OpenShortcutsCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- Title bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource MapChromeBgBrush}"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="10">
        <StackPanel Spacing="1">
          <TextBlock Text="APRS Command"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="APRS station map"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                x:Name="AprsIsBadgeBorder"
                Background="#1E293B"
                BorderBrush="{DynamicResource BadgeOutlineBrush}"
                BorderThickness="4"
                CornerRadius="4"
                Padding="10,6"
                VerticalAlignment="Center">
          <TextBlock x:Name="AprsIsBadgeText"
                     Text="APRS-IS Offline"
                     Foreground="#CBD5E1"
                     FontWeight="SemiBold" />
        </Border>
        <Border Grid.Column="2"
                x:Name="TxBadgeBorder"
                Background="#123B32"
                BorderBrush="{DynamicResource BadgeOutlineBrush}"
                BorderThickness="4"
                CornerRadius="4"
                Padding="10,6"
                VerticalAlignment="Center">
          <TextBlock x:Name="TxBadgeText"
                     Text="TX Disabled"
                     Foreground="#99F6E4"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <!-- Menu bar -->
    <Menu Grid.Row="1"
          Background="{DynamicResource PanelAccentBgBrush}">
      <MenuItem Header="_Settings" Command="{Binding OpenSettingsCommand}" />

      <MenuItem Header="_View">
        <MenuItem Header="Station _List" Command="{Binding OpenStationListCommand}" />
        <MenuItem Header="Raw _Packets" Command="{Binding OpenRawPacketsCommand}" />
        <MenuItem Header="_Telemetry Monitor" Command="{Binding OpenTelemetryCommand}" />
        <MenuItem Header="_Events" Command="{Binding OpenEventsCommand}" />
        <MenuItem Header="Packet _Statistics Dashboard" Click="OpenPacketStatistics_Click" />
        <Separator />
        <MenuItem Header="Toggle _Dark Mode" Command="{Binding ToggleDarkModeCommand}" />
      </MenuItem>

      <MenuItem Header="_Map">
        <MenuItem Header="_Draw">
          <MenuItem Header="✏ Draw Line"    Command="{Binding Map.DrawLineCommand}"    ToolTip.Tip="Click to add points, double-click to finish" />
          <MenuItem Header="⬟ Draw Polygon" Command="{Binding Map.DrawPolygonCommand}" ToolTip.Tip="Click to add points, double-click to close" />
          <MenuItem Header="◯ Draw Circle"  Command="{Binding Map.DrawCircleCommand}"  ToolTip.Tip="Press the centre and drag out to set the radius" />
          <MenuItem Header="🅣 Draw Text"   Command="{Binding Map.DrawTextCommand}"    ToolTip.Tip="Press and drag on the map to size the text, then type a label" />
          <MenuItem Header="↔ Resize / Move Text" Command="{Binding Map.DrawSelectTextCommand}" ToolTip.Tip="Click a label to select it, then drag its handle to resize or drag the label to move it" />
          <MenuItem Header="✕ Erase Shape"  Command="{Binding Map.DrawEraseCommand}"   ToolTip.Tip="Click a shape to delete it" />
          <Separator />
          <MenuItem Header="Drawing _Color">
            <MenuItem Header="Red"    Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#FF0000" />
            <MenuItem Header="Orange" Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#FF7A00" />
            <MenuItem Header="Yellow" Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#FFD400" />
            <MenuItem Header="Green"  Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#00C000" />
            <MenuItem Header="Blue"   Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#0066FF" />
            <MenuItem Header="Purple" Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#A000FF" />
            <MenuItem Header="Black"  Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#000000" />
            <MenuItem Header="White"  Command="{Binding Map.SetDrawColorCommand}" CommandParameter="#FFFFFF" />
            <Separator />
            <MenuItem Header="Custom color…" Command="{Binding Map.SetCustomColorCommand}" ToolTip.Tip="Open the color wheel to pick any color" />
            <MenuItem Header="Eyedropper — sample from map" Command="{Binding Map.DrawEyedropperCommand}" ToolTip.Tip="Click the map to grab that color as the drawing color" />
          </MenuItem>
          <MenuItem Header="Shape _Fill" ToolTip.Tip="Fill for polygons and circles">
            <MenuItem Header="None (outline only)" Command="{Binding Map.SetFillStyleCommand}" CommandParameter="None" />
            <MenuItem Header="Solid"            Command="{Binding Map.SetFillStyleCommand}" CommandParameter="Solid" />
            <MenuItem Header="Diagonal hatch"   Command="{Binding Map.SetFillStyleCommand}" CommandParameter="DiagonalHatch" />
            <MenuItem Header="Cross-hatch"      Command="{Binding Map.SetFillStyleCommand}" CommandParameter="CrossHatch" />
            <MenuItem Header="Horizontal lines" Command="{Binding Map.SetFillStyleCommand}" CommandParameter="Horizontal" />
            <MenuItem Header="Vertical lines"   Command="{Binding Map.SetFillStyleCommand}" CommandParameter="Vertical" />
            <MenuItem Header="Dotted"           Command="{Binding Map.SetFillStyleCommand}" CommandParameter="Dotted" />
          </MenuItem>
          <MenuItem Header="_Measurements" ToolTip.Tip="Show length / diameter / area on drawn shapes">
            <MenuItem Header="{Binding Map.MeasurementsMenuHeader}" Command="{Binding Map.ToggleMeasurementsCommand}" />
            <Separator />
            <MenuItem Header="Imperial (ft · mi · acres)" Command="{Binding Map.UseImperialUnitsCommand}" />
            <MenuItem Header="Metric (m · km · ha)"       Command="{Binding Map.UseMetricUnitsCommand}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Clear All Drawings" Command="{Binding Map.ClearDrawingsCommand}" />
          <Separator />
          <MenuItem Header="Import GPX / KML…"   Command="{Binding Map.ImportGeoFileCommand}" ToolTip.Tip="Load lines, tracks, and waypoints from a GPX or KML file onto the map" />
          <MenuItem Header="Export Drawings…"    Command="{Binding Map.ExportGeoFileCommand}" ToolTip.Tip="Save your drawn shapes to a GPX or KML file" />
        </MenuItem>
        <MenuItem Header="_Weather">
          <MenuItem Header="Weather Stations" Command="{Binding OpenWeatherCommand}" />
          <MenuItem Header="Weather Alerts" Command="{Binding OpenNwsAlertsCommand}" />
          <Separator />
          <MenuItem x:Name="ToggleRadarMenuItem"
                    Header="{Binding Map.RadarMenuHeaderText}"
                    Click="ToggleRadarMenuItem_Click" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Offline Map _Download" Command="{Binding OpenOfflineMapCommand}" />
        <MenuItem Header="_Coverage Prediction" Command="{Binding OpenCoverageCommand}" />
        <MenuItem Header="_Elevation Profile" Command="{Binding OpenElevationCommand}" />
        <MenuItem Header="_Frequency Reference" Command="{Binding OpenFrequencyRefCommand}" />
      </MenuItem>

      <MenuItem Header="Messa_ges">
        <MenuItem Header="_Messages" Command="{Binding OpenMessagesCommand}" />
        <MenuItem Header="Message _Broadcast" Command="{Binding OpenBroadcastCommand}" />
        <MenuItem Header="_Scheduled Messages" Command="{Binding OpenScheduledCommand}" />
        <MenuItem Header="Message _Receipts Dashboard" Command="{Binding OpenReceiptsCommand}" />
      </MenuItem>

      <MenuItem Header="_Operate">
        <MenuItem Header="_Net Control" Command="{Binding OpenNetControlCommand}" />
        <MenuItem Header="Net _Script Editor" Command="{Binding OpenNetScriptCommand}" />
        <MenuItem Header="_Objects" Command="{Binding OpenObjectsCommand}" />
        <MenuItem Header="Session _Templates" Click="OpenSessionTemplates_Click" />
        <Separator />
        <MenuItem Header="Scheduled _Beacons" Command="{Binding OpenScheduledBeaconsCommand}" />
        <MenuItem Header="S_hadow Beacon" Command="{Binding OpenShadowBeaconCommand}" />
        <MenuItem Header="_Alerts" Command="{Binding OpenAlertsCommand}" />
      </MenuItem>

      <MenuItem Header="_Tools">
        <MenuItem Header="Event Bus" Command="{Binding OpenEventBusCommand}" />
        <MenuItem Header="Replay" Command="{Binding OpenReplayCommand}" />
        <MenuItem Header="RF Diagnostics" Command="{Binding OpenRfDiagnosticsCommand}" />
        <MenuItem Header="After-Action Report" Command="{Binding OpenAfterActionCommand}" />
        <MenuItem Header="Mobile Companion Web View" Click="OpenMobileCompanion_Click" />
        <Separator />
        <MenuItem Header="Toggle Exercise Mode (inhibit all transmit)"
                  Command="{Binding ToggleExerciseModeCommand}" />
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_Help" Command="{Binding OpenHelpCommand}" />
        <MenuItem Header="_Keyboard Shortcuts" Command="{Binding OpenShortcutsCommand}" InputGesture="Ctrl+OemQuestion" />
        <Separator />
        <MenuItem Header="_About APRS Command" Command="{Binding OpenAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Main content: icon sidebar + map -->
    <Grid Grid.Row="4"
          ColumnDefinitions="56,*">

      <!-- Left icon sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource PanelAccentBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,1,0">
        <Border.Styles>
          <!-- Sidebar icon buttons. The default Fluent Button swapped in a dark pointer-over
               background/foreground on hover (blacking the glyphs out). Instead, every icon behaves the
               same: at rest it sits on the sidebar text colour; on hover it grows and fades in a subtle
               highlight, presses in slightly on click, and springs smoothly back when the pointer leaves.
               (Recolour is intentionally omitted — the OS renders the emoji icons in fixed colours it
               won't let us tint, so tinting only some icons would look inconsistent.) -->
          <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.18)" />
          </Style>
          <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26808080" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </Style>
          <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
          </Style>
          <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#44808080" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
          </Style>
        </Border.Styles>
        <Grid RowDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Top"
                    Spacing="4"
                    Margin="4,12">

          <!-- Map tools -->
          <Button ToolTip.Tip="Home / Reset view"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30"
                  Command="{Binding Map.HomeCommand}">
            <TextBlock Text="⌂" />
          </Button>
          <Button ToolTip.Tip="Centre on my station"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30"
                  Command="{Binding Map.CentreOnStationCommand}">
            <TextBlock Text="◎" />
          </Button>
          <Button ToolTip.Tip="Find station"
                  Command="{Binding Map.FindStationCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30">
            <TextBlock Text="🔍" />
          </Button>
          <Button ToolTip.Tip="Measure distance"
                  Command="{Binding Map.MeasureDistanceCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30">
            <TextBlock Text="📏" />
          </Button>
          <Button ToolTip.Tip="Map layer toggle"
                  Command="{Binding Map.ToggleMapLayerCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30">
            <TextBlock Text="🗺" />
          </Button>

          <!-- Divider -->
          <Border Height="1"
                  Background="{DynamicResource AppBorderBrush}"
                  Margin="4,8" />

          <!-- Operator tools -->
          <Button ToolTip.Tip="Beacon Now — transmit your position"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30"
                  Command="{Binding BeaconNowCommand}">
            <TextBlock Text="📡" />
          </Button>
          <Button ToolTip.Tip="Alert status"
                  Command="{Binding Map.AlertStatusCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="4,12"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  FontSize="30">
            <TextBlock Text="🔔" />
          </Button>

          <Button ToolTip.Tip="{Binding Map.CustomRingCenterLabel}"
                  Command="{Binding Map.ToggleRingsCommand}"
                  Padding="4,12"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="Transparent"
                  BorderThickness="0"
                  FontSize="30"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="⊙" />
          </Button>

          <Button ToolTip.Tip="{Binding Map.TrailsButtonTooltip}"
                  Command="{Binding Map.ToggleTrailsCommand}"
                  Padding="4,12"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="Transparent"
                  BorderThickness="0"
                  FontSize="30"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="🛤" />
          </Button>

          <Button ToolTip.Tip="{Binding Map.RadarButtonTooltip}"
                  Command="{Binding Map.ToggleRadarCommand}"
                  Padding="4,12"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{Binding Map.RadarButtonBackground}"
                  BorderThickness="0"
                  CornerRadius="6"
                  FontSize="30"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock Text="🌧" />
          </Button>
        </StackPanel>
        </Grid>
      </Border>

      <!-- Map fills everything -->
      <views:MapView Grid.Column="1"
                     x:Name="TheMapView"
                     DataContext="{Binding Map}" />

      <!-- Replay control bar — overlaid on the map during a replay review. Lives in the map
           window's own visual tree (paints with the map), so there's no separate-window paint
           delay. Shown only while reviewing a recording; the Replay window hides during that time. -->
      <Border Grid.Column="1"
              DataContext="{Binding Replay}"
              IsVisible="{Binding IsReplayMode}"
              VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,14,0,0"
              Background="{DynamicResource MapChromeBgBrush}"
              BorderBrush="{DynamicResource AccentTealBrush}" BorderThickness="1"
              CornerRadius="9" Padding="14,9"
              BoxShadow="0 8 22 -12 #55101828">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentTealBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Replay" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" Padding="14,6" />
          <Button Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" Padding="14,6" />
          <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding ShowStop}" Padding="14,6" />
          <Button Content="Replay again" Command="{Binding PlayCommand}" IsVisible="{Binding ShowReplayAgain}" Padding="14,6"
                  ToolTip.Tip="Clear and play the loaded log again from the start" />
          <Button Content="Return to Live" Command="{Binding ReturnToLiveCommand}" Padding="14,6"
                  ToolTip.Tip="Switch the map back to live traffic (shows anything received while replaying)" />
          <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="4,2" />
          <TextBlock Text="Speed" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
          <NumericUpDown Value="{Binding SpeedMultiplier}" Minimum="0.1" Maximum="20" Increment="0.5"
                         FormatString="0.#" Width="118" MinWidth="118" VerticalAlignment="Center"
                         ToolTip.Tip="Playback speed multiplier — raise it to fast-forward the replay" />
          <TextBlock Text="{Binding CurrentPositionText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </Border>

      <!-- Draw-mode control bar — on-map and prominent; visible while any draw tool is active. -->
      <Border Grid.Column="1"
              IsVisible="{Binding Map.IsDrawModeActive}"
              VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,14,0,0"
              Background="{DynamicResource MapChromeBgBrush}"
              BorderBrush="{DynamicResource AccentTealBrush}" BorderThickness="1"
              CornerRadius="9" Padding="14,9"
              BoxShadow="0 8 22 -12 #55101828">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentTealBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Map.DrawModeTooltip}" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="4,2" />
          <Button Content="Clear" Command="{Binding Map.ClearDrawingsCommand}" Padding="12,5"
                  ToolTip.Tip="Delete all drawings from the map" />
          <Button Content="✕ Exit" Command="{Binding Map.ExitDrawModeCommand}" Padding="12,5" FontWeight="SemiBold"
                  ToolTip.Tip="Leave draw mode and return to normal map panning (your drawings stay)" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- NWS weather alert banner — visible only when alerts are active -->
    <views:NwsAlertsBannerView Grid.Row="2"
                               DataContext="{Binding NwsAlerts}"
                               Cursor="Hand"
                               PointerPressed="NwsBanner_PointerPressed" />

    <views:MainStatusBarView Grid.Row="5" />
  </Grid>
</Window>
