<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aprs.Desktop.ViewModels"
             x:Class="Aprs.Desktop.Views.ReplayView"
             x:DataType="vm:ReplayViewModel">
  <Grid RowDefinitions="Auto,Auto,*"
        Margin="0,10,0,0"
        RowSpacing="8">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8">
      <StackPanel>
        <TextBlock Text="Replay Mode"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding TransmitStatusText}"
                   Foreground="{DynamicResource AccentTealBrush}"
                   FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="{Binding State}"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleBarBorderBrush}" />
    </Grid>

    <Grid Grid.Row="1"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="6"
          RowSpacing="6">
      <TextBox Watermark="Replay file path — or click Browse to select a log file"
               Text="{Binding SelectedReplayFilePath}" />
      <Button Grid.Column="1"
              Command="{Binding BrowseCommand}"
              Content="Browse…"
              Padding="10,6"
              ToolTip.Tip="Select an APRS packet log file to replay" />
      <Button Grid.Column="2"
              Command="{Binding LoadCommand}"
              Content="Load"
              Padding="10,6" />
      <Button Grid.Column="3"
              Command="{Binding PlayCommand}"
              Content="Play"
              Padding="14,6"
              ToolTip.Tip="Clear the map and replay the loaded log; playback controls appear on the map. Live traffic is cached until you return to live" />

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <TextBlock Text="Speed" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding SpeedMultiplier}"
                       Minimum="0.1"
                       Maximum="20"
                       Increment="0.5"
                       FormatString="0.#"
                       Width="118" />
        <CheckBox Content="Loop"
                  IsChecked="{Binding LoopReplay}" />
        <TextBlock Text="{Binding CurrentPositionText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Text="{Binding LastError}"
                 Foreground="{DynamicResource ErrorBorderBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
    </Grid>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource TextSidebarBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource TextTitleBarBrush}"
            Padding="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         FontFamily="Menlo,Consolas,monospace"
                         FontSize="12"
                         Foreground="{DynamicResource TitleBarBorderBrush}"
                         Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
