<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aprs.Desktop.ViewModels"
             xmlns:conv="using:Aprs.Desktop.Converters"
             x:Class="Aprs.Desktop.Views.StationListView"
             x:DataType="vm:StationListViewModel">
  <Grid RowDefinitions="Auto,Auto,*"
        RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="8">
      <StackPanel Spacing="1">
        <TextBlock Text="{Binding RowCount, StringFormat='{}{0} visible stations'}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Newest first · click a callsign to centre the map"
                   FontSize="11"
                   Foreground="{DynamicResource TextSubtleBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Padding="10,5"
              Click="SortByLastHeard_Click">
        <TextBlock Text="Recent" />
      </Button>
    </Grid>

    <Grid Grid.Row="1"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="6">
      <TextBox Watermark="Search callsign or label"
               Text="{Binding SearchText}"
               TextChanged="SearchTextBox_TextChanged" />

      <Grid Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="6">
        <CheckBox Content="Active only"
                  IsChecked="{Binding ShowActiveOnly}"
                  Checked="ActiveOnlyCheckBox_Changed"
                  Unchecked="ActiveOnlyCheckBox_Changed" />
        <CheckBox Grid.Column="1"
                  Content="Show expired"
                  IsChecked="{Binding ShowExpiredStations}"
                  Checked="ShowExpiredCheckBox_Changed"
                  Unchecked="ShowExpiredCheckBox_Changed" />
      </Grid>

      <ComboBox Grid.Row="2"
                SelectedItem="{Binding SelectedPacketSourceFilter}"
                SelectionChanged="PacketSourceComboBox_SelectionChanged"
                ItemsSource="{Binding PacketSourceFilterOptions}" />
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">

      <!-- Sort header -->
      <Border Background="{DynamicResource PanelAccentHeaderBrush}" CornerRadius="8" Padding="12,8">
        <Grid ColumnDefinitions="1.2*,1.2*,1.4*,.9*,.9*" ColumnSpacing="6">
          <Button Padding="0" Background="Transparent" BorderBrush="Transparent" Click="SortByCallsign_Click">
            <TextBlock Text="Call" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </Button>
          <Button Grid.Column="1" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="SortByDisplayName_Click">
            <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </Button>
          <TextBlock Grid.Column="2" Text="Symbol" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Grid.Column="3" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="SortByAgeState_Click">
            <TextBlock Text="Age" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </Button>
          <Button Grid.Column="4" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="SortByPacketSource_Click">
            <TextBlock Text="Src" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </Button>
        </Grid>
      </Border>

      <ListBox x:Name="StationRowsListBox"
               Grid.Row="1"
               ItemsSource="{Binding Rows}"
               SelectionChanged="StationRowsListBox_SelectionChanged"
               Background="Transparent"
               Padding="0"
               BorderThickness="0">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:pointerover Border#RowCard">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTealBorderBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected Border#RowCard">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTealBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:StationListRowViewModel">
            <Border x:Name="RowCard"
                    Margin="0,0,0,6" Padding="11,9"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                <Grid ColumnDefinitions="1.2*,1.2*,1.4*,.9*,.9*" ColumnSpacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             Fill="{Binding AgeState, Converter={x:Static conv:StationStatusBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Callsign}"
                               FontFamily="Consolas, Menlo, Courier New"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Border IsVisible="{Binding IsLoRa}"
                            Background="#7C3AED" CornerRadius="3"
                            Padding="4,1" VerticalAlignment="Center">
                      <TextBlock Text="LoRa" FontSize="8" FontWeight="Bold" Foreground="White" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding SymbolDescription}"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding AgeStateLabel}"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Text="{Binding PacketSourceLabel}"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding MetaLine}"
                           FontFamily="Consolas, Menlo, Courier New"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{Binding Comment}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="3" IsVisible="{Binding HasDevice}"
                           Text="{Binding Device, StringFormat='Device: {0}'}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
